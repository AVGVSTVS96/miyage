{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "bun install --frozen-lockfile --ignore-scripts",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.miyage.dev" }],
      "destination": "https://miyage.dev/$1",
      "permanent": true
    }
  ]
}
